<!DOCTYPE html>
<html>
<head>
  <title>Admin Predictions</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="dark">

<div class="app-layout">

  <aside class="sidebar">
    <div class="brand">⚽ Admin Panel</div>
    <a href="/admin/dashboard">Payments</a>
    <a class="active" href="/admin/predictions">Predictions</a>
    <a href="/logout">Logout</a>
  </aside>

  <main class="main-content">
    <div class="topbar">
      <div>
        <h1>Prediction Manager</h1>
        <p>Add premium football predictions for paid users</p>
      </div>
      <a href="/admin/dashboard" class="btn">Payment Dashboard</a>
    </div>

    <div class="glass-card">
      <h2>Add Game Prediction</h2>

      <form action="/admin/predictions/add" method="POST">
        <label>Match Name</label>
        <input name="matchName" placeholder="Barcelona vs Real Madrid" required>

        <label>League</label>
        <input name="league" placeholder="La Liga" required>

        <label>Match Date</label>
        <input type="datetime-local" name="matchDate" required>

        <label>Category</label>
        <select name="category" required>
          <option>Premium Prediction</option>
          <option>Free Prediction</option>
          <option>High Confidence Pick</option>
          <option>Risky Pick</option>
          <option>VIP Pick</option>
        </select>

        <label>Predicted Winner</label>
        <input name="predictedWinner" placeholder="Barcelona" required>

        <label>Predicted Score</label>
        <input name="predictedScore" placeholder="2 - 1" required>

      

        <label>Prediction Analysis</label>
        <textarea name="analysis" placeholder="Detailed match analysis..." required></textarea>

        <button type="submit">Add Prediction</button>
      </form>
    </div>

    <div class="glass-card">
      <h2>All Predictions</h2>

      <table class="admin-table">
        <tr>
          <th>Match</th>
          <th>League</th>
          <th>Category</th>
          <th>Winner</th>
          <th>Score</th>
          <th>Result</th>
          <th>Update Result</th>
          <th>Action</th>
        </tr>

        <% predictions.forEach(prediction => { %>
          <tr>
            <td><%= prediction.matchName %></td>
            <td><%= prediction.league %></td>
            <td><%= prediction.category %></td>
            <td><%= prediction.predictedWinner %></td>
            <td><%= prediction.predictedScore %></td>
            <td><%= prediction.resultStatus %></td>

            <td>
              <form action="/admin/predictions/result/<%= prediction._id %>" method="POST">
                <select name="resultStatus">
                  <option <%= prediction.resultStatus === "Pending Result" ? "selected" : "" %>>Pending Result</option>
                  <option <%= prediction.resultStatus === "Correct" ? "selected" : "" %>>Correct</option>
                  <option <%= prediction.resultStatus === "Wrong" ? "selected" : "" %>>Wrong</option>
                </select>
                <button>Update</button>
              </form>
            </td>

            <td>
              <form action="/admin/predictions/delete/<%= prediction._id %>" method="POST">
                <button class="delete-btn">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </table>
    </div>
  </main>
</div>

</body>
</html>